class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int maxF = -1;
        int cand = 0, max = 0;

        for (int i = 0; i < nums.length; i++) {
            maxF = Math.max(maxF, nums[i]);

            if (i == cand) max = maxF;

            if (nums[i] < max - k)
                cand = i + 1;
        }

        return cand < nums.length ? cand : -1;
    }
}